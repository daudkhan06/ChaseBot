# Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# PayPal sandbox app (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Optional: webhook ID from your PayPal app's Webhooks section (needed to accept webhooks)
PAYPAL_WEBHOOK_ID=

# Optional: your sandbox *personal* account email. Demo clients get +aliases of it
# (you+sam@…, you+jordan@…) so you can log in as the buyer and pay invoices.
DEMO_CLIENT_EMAIL=

# Optional: run without PayPal credentials using an in-memory imitation of the API
# PAYPAL_MOCK=true
